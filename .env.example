# Copie para .env.local e preencha (nunca commite o .env.local).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": SÓ no servidor. Usada pela página pública do relatório e pelo cron.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do sistema (links do relatório enviados por e-mail). Ex.: https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (e-mail). Em desenvolvimento, sem chave, o envio só grava no log (modo teste).
RESEND_API_KEY=
# Remetente em domínio verificado no Resend. Ex.: Rixxer <relatorios@seudominio.com.br>
EMAIL_FROM=
# Responder para (opcional)
EMAIL_REPLY_TO=
# "live" só quando quiser enviar e-mails de verdade. Qualquer outro valor = modo teste (apenas log).
EMAIL_MODE=test

# Cron semanal (segunda cedo). DESLIGADO por padrão.
CRON_SECRET=
WEEKLY_EMAIL_CRON_ENABLED=false
